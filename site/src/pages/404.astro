---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Matt Shaw" description="That page isn't on the menu.">
  <main id="main" class="wrap notfound">
    <p class="eyebrow">404 · Not found</p>
    <h1>86'd.</h1>
    <p>That page isn't on the menu, or it moved. Here is what is.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/projects/">Projects</a>
      <a class="btn btn-ghost" href="/writing/">Writing</a>
    </div>
  </main>
</BaseLayout>

---
import ProjectCard from './ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const featured = all.slice(0, 4);
---
<section id="work" class="block">
  <div class="wrap">
    <p class="eyebrow">The pass</p>
    <h2>Selected work</h2>
    <div class="grid">
      {featured.map((p, i) => <ProjectCard project={p} no={all.length - i} />)}
    </div>
    <p class="more"><a href="/projects/">All {all.length} projects →</a></p>
  </div>
</section>
<style>
  .grid { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 48px; }
</style>
